<?xml version="1.0"?>
<!--
    Copyright © 2026 Roman Pasichnyk
    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Plugs the Braintree card form into Zero Checkout's payment step, below the
    method list. Disabling Zero_Braintree removes it.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="zero.checkout.payment.forms">
            <block class="Magento\Framework\View\Element\Template" name="zero.checkout.payment.braintree"
                   template="Zero_Braintree::checkout/hosted-fields.phtml">
                <arguments>
                    <argument name="braintreeConfig" xsi:type="object">Zero\Braintree\ViewModel\CheckoutConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
